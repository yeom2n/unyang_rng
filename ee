    });
    document.getElementById("searchInput").value = "";
    renderList(cls);
  }

  // 전체 검색 기능
  function filterList() {
    const query = document.getElementById("searchInput").value.trim().toLowerCase();
    const listEl = document.getElementById("studentList");

    if (query === "") {
      renderList(currentClass);
      return;
    }

    let allMatches = [];
    Object.keys(classData).forEach(cls => {
      classData[cls].forEach(student => {
        if (student.name.toLowerCase().includes(query) || student.no.includes(query)) {
          allMatches.push({ ...student, cls: cls });
        }
      });
    });

    if (allMatches.length === 0) {
      listEl.innerHTML = '<div class="row" style="justify-content:center; color:var(--sub); padding: 20px;">전체 학급에서 일치하는 학생을 찾을 수 없습니다.</div>';
      return;
    }

    listEl.innerHTML = allMatches.map(item => `
      <div class="row" data-class="${item.cls}" data-name="${item.name}" data-no="${item.no}">
        <span class="class-badge">${item.cls}반</span>
        <span class="order">${item.order}순위</span>
        <span class="no">${item.no}</span>
        <span class="name">${item.name}</span>
      </div>
    `).join('');
  }

  // 로컬 저장 연동 체크리스트
  function saveCheck(idx) {
    const checks = JSON.parse(localStorage.getItem("eval_checks") || "{}");
    const inputs = document.querySelectorAll("#checkList input");
    checks[idx] = inputs[idx].checked;
    localStorage.setItem("eval_checks", JSON.stringify(checks));
  }

  function loadChecks() {
    const checks = JSON.parse(localStorage.getItem("eval_checks") || "{}");
    const inputs = document.querySelectorAll("#checkList input");
    inputs.forEach((input, idx) => {
      if(checks[idx]) input.checked = true;
    });
  }

